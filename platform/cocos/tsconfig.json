{
  "extends": "./temp/tsconfig.cocos.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "assets/scripts/**/*.ts",
    "assets/scripts/canonical/**/*.js"
  ],
  "exclude": [
    "build",
    "library",
    "temp",
    "profiles",
    "local",
    "native"
  ]
}
